# ============================================================
# RAG Research Assistant - Environment Configuration
# Copy to .env and fill in your values
# ============================================================

# --- Application ---
APP_NAME="RAG Research Assistant"
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALLOWED_HOSTS=["localhost","127.0.0.1","0.0.0.0"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- JWT ---
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://raguser:ragpassword@localhost:5432/ragdb
DATABASE_URL_SYNC=postgresql://raguser:ragpassword@localhost:5432/ragdb
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_DB=1
REDIS_CELERY_DB=2
CACHE_TTL_SECONDS=3600

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.1

# --- Vector Store ---
VECTOR_STORE_TYPE=faiss  # faiss or chroma
FAISS_INDEX_PATH=./data/faiss_index
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_NAME=research_docs

# --- Document Processing ---
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=["pdf","docx","txt","md"]
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_CHUNKS_PER_DOC=500

# --- RAG Settings ---
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.7
RAG_MAX_CONTEXT_LENGTH=4000
ENABLE_RERANKING=true
ENABLE_HYBRID_SEARCH=true

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# --- Monitoring ---
ENABLE_METRICS=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Admin ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123!
